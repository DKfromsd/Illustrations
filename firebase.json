{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/package*.json",
      "**/tsconfig*.json",
      "**/dist/**",
      "**/temp/**",
      "**/cache/**",
      "**/*.log",
      "assets/**",
      "icon/**",
      "img/**",
      "css/**",
      "js/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/animator/**",
        "destination": "/animator/index.html"
      }
    ]
  }
}